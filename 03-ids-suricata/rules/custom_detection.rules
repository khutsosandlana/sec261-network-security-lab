alert tcp any any -> any any (msg:"[CTI ALERT] Active Nmap Stealth SYN Scan Detected"; flags:S; threshold: type threshold, track by_src, count 15, seconds 3; classtype:attempted-recon; sid:1000001; rev:2;)
alert tcp any any -> any 80 (msg:"[CTI ALERT] Unencrypted Port 80 Connection Probe"; flags:S; flow:stateless; classtype:attempted-recon; sid:1000002; rev:2;)
alert icmp any any -> any any (msg:"[CTI ALERT] High Volume ICMP Ping Sweep Detected"; itype:8; threshold: type threshold, track by_src, count 5, seconds 3; classtype:attempted-recon; sid:1000003; rev:2;)
